# Copy to .env for local development. Never commit the real .env file.

# Required. Signing key for JWT access tokens: at least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value

# Optional. Defaults to a local SQLite file (./local.db) when not set.
# On Render, this is provided by the attached PostgreSQL database.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional. Access token lifetime in minutes (default 60).
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional. Creates the first admin account on startup if it does not exist yet.
# FIRST_ADMIN_EMAIL=admin@example.com
# FIRST_ADMIN_PASSWORD=use-a-strong-password
